# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
# ...but tools/coverage/ is SOURCE — the image-coverage reporter. The rule
# above is unanchored, so it swallows any directory called "coverage" at any
# depth, and `git add tools/coverage/...` refuses without -f. Un-ignore it so a
# second file added there does not silently go untracked.
!tools/coverage/
*.lcov

# nyc test coverage
.nyc_output

