{{define "contact"}}<!doctype html>
<html lang="en">
<head>
{{template "head" .}}
</head>
<body>
{{template "header" .}}
<main>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Wholesale Contact</span>
      <h1>Reach the FineVines Team</h1>
      <p class="lede">FineVines is a licensed wholesale distributor of wine and spirits, serving Chicagoland's
        restaurants, retailers, and hospitality accounts. For allocations, new accounts, or a visit from your
        sales representative, reach us directly below.</p>
    </div>
  </section>

  <section class="wrap">
    <div class="callout">
      <p><strong>Wholesale inquiries only.</strong> FineVines sells exclusively to licensed
        retailers, restaurants, and hospitality accounts within Illinois.</p>
    </div>

    {{/* Account testimonial: rendered only when site.json carries a quote.
         Borrowed credibility at the decision point — someone ELSE vouching
         for the house, next to where a prospect makes contact. site.json's
         testimonialConfirmed gates production deploys (model.SiteContent):
         drafted-not-approved quotes are preview-only by policy. */}}
    {{if .Content.Testimonial.Quote}}<figure class="testimonial">
      <blockquote>&ldquo;{{.Content.Testimonial.Quote}}&rdquo;</blockquote>
      <figcaption>{{.Content.Testimonial.Attribution}}</figcaption>
    </figure>{{end}}

    <hr class="rule-gold">

    <h2>Warehouse &amp; Office</h2>
    <address class="contact-address">
      {{.Content.Contact.Street}}<br>
      {{.Content.Contact.CityStateZIP}}
    </address>

    <h2>Contact</h2>
    <p class="contact-links">
      Phone: <a href="tel:{{.Content.Contact.PhoneHref}}">{{.Content.Contact.PhoneDisplay}}</a><br>
      Fax: <a href="tel:{{.Content.Contact.FaxHref}}">{{.Content.Contact.FaxDisplay}}</a><br>
      Email: <a href="mailto:{{.Content.Contact.Email}}">{{.Content.Contact.Email}}</a>
    </p>

    <h2>Your Sales Representative</h2>
    <p class="lede">Existing accounts should reach out to their dedicated representative directly. New to
      FineVines? Get in touch and we'll connect you with the right person for your territory.</p>
  </section>
</main>
{{template "footer" .}}
</body>
</html>
{{end}}
