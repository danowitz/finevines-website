          </a></li>
        </ul>
      </div>
      <nav class="footer-nav" aria-label="Explore">
        <h2 class="footer-heading">Explore</h2>
        <ul>
          <li><a href="/portfolio/">Portfolio</a></li>
          <li><a href="/news/">News &amp; Events</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      {{/* The three ways into the catalog other than the portfolio itself.
           They live in the footer — on every page — because that is what
           makes 500-odd collection pages discoverable by following links rather
           than by reading sitemap.xml. */}}
      <nav class="footer-nav" aria-label="Browse the catalog">
        <h2 class="footer-heading">Browse</h2>
        <ul>
          <li><a href="/producers/">Producers</a></li>
          <li><a href="/regions/">Regions</a></li>
          <li><a href="/varietals/">Varietals</a></li>
        </ul>
      </nav>
      <div class="footer-nav footer-wholesale">
        <h2 class="footer-heading">Wholesale</h2>
        <p><a class="footer-wholesale-cta" href="/contact/">Become a Customer</a></p>
        <p class="footer-wholesale-note">Wholesale only: licensed retailers, restaurants &amp; hospitality accounts in Illinois.</p>
      </div>
      <div class="footer-nav footer-contact">
        <h2 class="footer-heading">Contact</h2>
        <address class="footer-address">
          <a href="tel:{{.Content.Contact.PhoneHref}}">{{.Content.Contact.PhoneDisplay}}</a><br>
          <a href="mailto:{{.Content.Contact.Email}}">{{.Content.Contact.Email}}</a>
        </address>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">&copy; 2026 FineVines. All rights reserved.</p>
      <p class="footer-legal">Licensed wholesale distributor of wine &amp; spirits, State of Illinois.</p>
      {{/* CalOPPA requires the link to this page to be conspicuous and to
           contain the word "Privacy" (see templates/privacy-policy.html.tmpl's
           CalOPPA section) — it lives in the footer, on every page. */}}
      <nav class="footer-legal-links" aria-label="Legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/legal/">Legal</a>
      </nav>
    </div>
  </div>
</footer>
{{end}}
