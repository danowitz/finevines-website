{{/*
  base.html.tmpl — shared head/header/footer for every page.

  These are named templates, not a page of their own: each page template
  (home.html.tmpl, contact.html.tmpl, and later portfolio/wine/news/about)
  defines its own top-level {{define "<name>"}} that assembles <!doctype
  html> + head + header + that page's own content + footer, then Run()
  executes that top-level name directly (see build.go's pages slice).

  The dot passed into "head"/"header"/"footer" is always a `page` value (or
  something that embeds one) — see build.go — so BaseURL/Title/Description/
  Path are reachable as plain fields via Go's embedded-struct promotion.
*/}}

{{define "head"}}<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
{{/* .NoIndex is promoted from site.NoIndex (build.go) — true on every host
     except the production domain (finevines.com / www.finevines.com), so a
     staging or review build never competes with the real site in search
     results. The 404 page overrides this to always-true regardless of host
     (see notFoundPage). robots.txt alone isn't enough here: it stops future
     crawling but can't remove a URL a search engine already indexed, and
     this meta tag is what actually does that. */}}
{{if .NoIndex}}<meta name="robots" content="noindex">
{{end}}<link rel="canonical" href="{{.BaseURL}}{{.Canonical}}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="FineVines">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Description}}">
<meta property="og:url" content="{{.BaseURL}}{{.Path}}">
<meta property="og:image" content="{{.OGImageURL}}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="FineVines - pouring elegance with a sommelier's touch">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@finevineswine">
<meta name="twitter:creator" content="@finevineswine">
<meta name="twitter:title" content="{{.Title}}">
<meta name="twitter:description" content="{{.Description}}">
<meta name="twitter:image" content="{{.OGImageURL}}">
<meta name="theme-color" content="#531427">
<link rel="icon" href="/assets/img/favicon.ico" sizes="any">
<link rel="stylesheet" href="{{.CSSURL}}">
{{if and .GAID (hasPrefix .GAID "G-")}}<script async src="https://www.googletagmanager.com/gtag/js?id={{.GAID}}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{.GAID}}');</script>
{{end}}{{end}}

{{define "header"}}<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="FineVines home"><img src="/assets/img/finevines-logo.png" alt="FineVines" width="172"></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-nav">
      <a href="/"{{if eq .Path "/"}} aria-current="page"{{end}}>Home</a>
      <a href="/portfolio/"{{if eq .Path "/portfolio/"}} aria-current="page"{{end}}>Portfolio</a>
      <a href="/news/"{{if eq .Path "/news/"}} aria-current="page"{{end}}>News &amp; Events</a>
      <a href="/about/"{{if eq .Path "/about/"}} aria-current="page"{{end}}>About Us</a>
      <a href="/contact/"{{if eq .Path "/contact/"}} aria-current="page"{{end}}>Contact</a>
      <a class="btn btn-cta" href="/contact/">Become a Customer</a>
    </nav>
  </div>
  <script src="{{.NavJSURL}}" defer></script>
</header>
{{end}}

{{define "news-empty"}}<p class="news-empty">Fresh notes from the FineVines team are on the way.</p>{{end}}

