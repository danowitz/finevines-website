{{/*
  about.html.tmpl — dist/about/index.html.

  Dot is a plain page (build.go), not a wrapper type: .Team is already
  reachable through the embedded *site, so there is no aboutPage struct.
  This is the "page embeds page directly" case Task 8 calls out — it must
  NOT be a bare *site, since head/header/footer need .Title/.Path, which
  page supplies.

  Company copy below is transcribed verbatim from FineVines' own About
  copy as it appears in the approved proposal (index.html, repo root,
  "About us" section, ~line 438-446) — a durable decision per CLAUDE.md:
  this is FineVines' existing voice, not rewritten marketing prose. The
  proposal's own narration sentence ("The About page keeps FineVines' own
  words...") is proposal meta-commentary and is excluded here; everything
  below it is the actual company copy.
*/}}
{{define "about"}}<!doctype html>
<html lang="en">
<head>
{{template "head" .}}
</head>
<body>
{{template "header" .}}
<main>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About Us</span>
      <h1>A service company, first and last.</h1>
      <p class="lede">The team is the sales force, the drivers, and the warehouse and support staff &mdash;
        everyone focused on the best possible service to customers and suppliers.</p>
    </div>
  </section>

  <section class="wrap">
    <p class="lede">Every product is handled under proper temperature and humidity: orders picked with care
      and loaded in a temperature-controlled warehouse.</p>
    <p>The sales team carries a combined <strong>200+ years</strong> in the wholesale wine, retail and
      restaurant trade &mdash; and training your staff is part of the service. Need information, technical
      specs, or an in-person session? Just ask.</p>
  </section>

  <section class="wrap">
    <span class="eyebrow">The Team</span>
    <h2>Who You&rsquo;ll Talk To</h2>
    <div class="team-grid">
      {{range .Team}}<div class="team-card">
        {{if .PhotoPath}}<img src="/{{.PhotoPath}}" alt="Portrait of {{.Name}}">{{end}}
        <div class="name">{{.Name}}</div>
        <div class="role">{{.Role}}</div>
        {{if .Note}}<p>{{.Note}}</p>{{end}}
        <a class="email" href="mailto:{{.Email}}">{{.Email}}</a>
      </div>
      {{end}}
    </div>
  </section>
</main>
{{template "footer" .}}
</body>
</html>
{{end}}
