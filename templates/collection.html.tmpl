{{/*
  collection.html.tmpl — one facet value's landing page:
  dist/producers/<slug>/, dist/regions/<slug>/, dist/varietals/<slug>/
  (and /page/N/ under each when the cut runs past one page).

  Dot is a collectionPage (collections.go): the embedded `page` supplies Title/Description/
  Path/BaseURL for head/header/footer; .Kind names the dimension; .Name is
  this value's canonical spelling; .Cards is only THIS page's slice; and
  .Related carries the cross-links into the neighbouring dimensions.

  This page is deliberately server-only — no catalog-index fetch, no client
  engine. It exists to BE indexed and to pass link equity onward, and it
  hands off to /portfolio/?<facet>=<value> (.FilterURL) the moment a visitor
  wants to refine rather than browse. Keeping it static is also what makes
  520-odd of these cheap: no JS, no data file, just cards.

  Cards come from the shared "winecard" definition (card.html.tmpl), the
  same one the portfolio uses, so a wine looks identical wherever it is met.
*/}}
{{define "collection"}}<!doctype html>
<html lang="en">
<head>
{{template "head" .}}
{{/* What this page IS: schema.org's exact type for a page whose subject is a
     set of other pages, with the wines shown on it as an ItemList in display
     order. That is the difference between a search engine reading this as a
     listing of N wines and reading it as one document that happens to
     mention them. The list describes THIS page's slice, not the whole cut —
     page 2 lists page 2's wines. */}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{.Name}},
  "url": {{printf "%s%s" .BaseURL .Path}},
  "description": {{.Description}},
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{len .Cards}},
    "itemListElement": [{{range $i, $c := .Cards}}{{if $i}}, {{end}}{"@type": "ListItem", "position":{{inc $i}}, "url": {{printf "%s/wines/%s/" $.BaseURL $c.Slug}}, "name": {{spaceJoin $c.Producer $c.Name}}}{{end}}]
  }
}
</script>
{{/* BreadcrumbList tells search engines where this page sits — Portfolio →
     Producers → Benjamin Leroux — which is what earns the breadcrumb trail
     shown under a result instead of a bare URL. */}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{{range $i, $crumb := .Crumbs}}{{if $i}},{{end}}
    {"@type": "ListItem", "position": {{inc $i}}, "name": {{$crumb.Name}}, "item": {{printf "%s%s" $.BaseURL $crumb.URL}}}{{end}}
  ]
}
</script>
</head>
<body>
{{template "header" .}}
<main>
  <section class="page-hero page-hero-plain">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">{{range $i, $crumb := .Crumbs}}{{if $i}}<span aria-hidden="true">/</span>{{end}}{{if lt (inc $i) (len $.Crumbs)}}<a href="{{$crumb.URL}}">{{$crumb.Name}}</a>{{else}}<span aria-current="page">{{$crumb.Name}}</span>{{end}}{{end}}</nav>
      <span class="eyebrow">{{.Kind.Singular}}</span>
      <h1>{{.Name}}</h1>
      <p class="lede">{{.Lede}}</p>
    </div>
  </section>

  {{with .Editorial}}
  <section class="wrap collection-editorial" aria-labelledby="collection-editorial-title">
    <div class="collection-editorial-copy">
      <span class="eyebrow">{{.Eyebrow}}</span>
      <h2 id="collection-editorial-title">{{.Heading}}</h2>
      {{range .Paragraphs}}<p>{{.}}</p>{{end}}
    </div>
    {{with .Images}}<div class="collection-editorial-gallery">
      {{range .}}<figure class="{{if .Curated}}is-curated{{else}}is-bottle{{end}}">
        {{if .Href}}<a href="{{.Href}}"><img src="/{{.Path}}" alt="{{.Alt}}" loading="lazy"></a>{{else}}<img src="/{{.Path}}" alt="{{.Alt}}" loading="lazy">{{end}}
        <figcaption>{{.Caption}}{{if .SourceURL}} <a href="{{.SourceURL}}" rel="external">{{.Credit}}, {{.License}}</a>{{end}}</figcaption>
      </figure>{{end}}
    </div>{{end}}
    {{with $.Peers}}<nav class="collection-peers" aria-labelledby="collection-peers-title">
      <h3 id="collection-peers-title">Explore related {{$.Kind.Plural | lower}}</h3>
      <ul>{{range .}}<li><a href="{{.URL}}">{{.Name}}</a></li>{{end}}</ul>
    </nav>{{end}}
    {{with $.RegionHierarchy}}<nav class="collection-peers" aria-labelledby="region-hierarchy-title">
      <h3 id="region-hierarchy-title">Explore the regional hierarchy</h3>
      <ul>{{range .}}<li><a href="{{.URL}}">{{.Name}}</a></li>{{end}}</ul>
    </nav>{{end}}
    {{with $.Intersections}}<nav class="collection-peers" aria-labelledby="collection-intersections-title">
      <h3 id="collection-intersections-title">Explore focused selections</h3>
      <ul>{{range .}}<li><a href="{{.URL}}">{{.Name}} <span>({{.Count}})</span></a></li>{{end}}</ul>
    </nav>{{end}}
    {{with .Sources}}<p class="collection-editorial-sources">Sources: {{range $i, $source := .}}{{if $i}} · {{end}}<a href="{{$source.URL}}" rel="external">{{$source.Label}}</a>{{end}}</p>{{end}}
  </section>
  {{end}}

  <section class="wrap">
    <div class="collection-toolbar">
      <p class="collection-count">{{comma .Total}} {{if eq .Total 1}}wine{{else}}wines{{end}}{{if gt .PageCount 1}} &middot; page {{.PageNum}} of {{.PageCount}}{{end}}</p>
      {{/* The static page ranks; the portfolio filters. Anyone who wants to
           narrow this cut further gets handed to the client engine with the
           selection already applied. */}}
      <a class="collection-filter-link" href="{{.FilterURL}}">Refine in the portfolio</a>
    </div>

    <ul class="wine-grid view-cards" style="list-style:none;margin:0;padding:0;">
      {{range .Cards}}
      {{template "winecard" .}}
      {{end}}
    </ul>

    {{/* Real prev/next links, same convention as the portfolio: page 1 is the
         bare collection URL so a paginated cut never publishes /page/1/ as a second
         address for identical content. A missing neighbour renders as a
         disabled <span> rather than a dead link. */}}
    {{if gt .PageCount 1}}
    <nav class="pagination" aria-label="{{.Name}} pages">
      {{if .PrevURL}}<a class="pagination-btn pagination-prev" rel="prev" href="{{.PrevURL}}">Previous</a>{{else}}<span class="pagination-btn pagination-prev is-disabled" aria-disabled="true">Previous</span>{{end}}
      <span class="pagination-status">Page {{.PageNum}} of {{.PageCount}}</span>
      {{if .NextURL}}<a class="pagination-btn pagination-next" rel="next" href="{{.NextURL}}">Next</a>{{else}}<span class="pagination-btn pagination-next is-disabled" aria-disabled="true">Next</span>{{end}}
    </nav>
    {{end}}

    {{/* Cross-links into the neighbouring dimensions. This is the whole
         reason the collections are worth building: a producer's page opens onto its
         regions and varietals, and each of those opens onto every other
         producer working the same ground. */}}
    {{range .Related}}
    <section class="collection-related">
      <h2>{{.Label}}</h2>
      <ul>{{range .Links}}<li><a href="{{.URL}}">{{.Name}}</a></li>{{end}}</ul>
    </section>
    {{end}}

    <p class="collection-index-link"><a href="{{.IndexURL}}">All {{.Kind.Plural | lower}}</a></p>
  </section>
</main>
{{template "footer" .}}
</body>
</html>
{{end}}
