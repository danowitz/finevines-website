{{/*
  portfolio.html.tmpl — dist/portfolio/index.html and dist/portfolio/page/N/
  index.html: ONE paginated slice of the catalog (this page's 48 wine cards)
  rendered as real, crawlable HTML, plus the facet sidebar, search box, sort
  control, view toggle, and prev/next pagination that a no-JS visitor or a
  crawler can walk the whole catalog with. assets/js/portfolio.js then
  progressively takes over: it fetches the compact catalog-index and, from
  then on, does ALL filtering/sorting/pagination client-side, keeping only ~48
  cards in the DOM at a time (the old page pre-rendered all ~2,600 → 2MB HTML).

  Dot is a portfolioPage (build.go): the embedded `page` supplies
  Title/Description/Path/BaseURL for head/header/footer; .Facets are the
  sidebar filter groups (computed + sorted in Go over the WHOLE catalog, not
  just this page); .Wines is only THIS page's slice; and the pagination fields
  (.PageNum/.PageCount/.Total/.PrevURL/.NextURL/.IndexURL/.PageSize) drive the
  nav + the JS hand-off.

  JS↔template hook contract with assets/js/portfolio.js (must match exactly on
  both sides — the JS reproduces the card markup below verbatim so its
  client-rendered cards are indistinguishable from these server-rendered ones):
    - grid:            <ul class="wine-grid"> carrying data-index-url /
                       data-page-size / data-page / data-page-count
    - card:            <li data-slug><a class="wine-card">…</a></li> (see below)
    - facet checkbox:  <input data-facet="<facet>" value="<value>"> under .facet,
                       with a sibling <span class="facet-count"> the JS fills
    - search box:      #portfolio-search
    - sort select:     #portfolio-sort   (producer|name|vintage|region)
    - result counter:  #portfolio-count
    - pagination:      <nav class="pagination"> (JS rebuilds its contents)
    - empty state:     #portfolio-empty (+ .portfolio-clear reset button)
*/}}
{{define "portfolio"}}<!doctype html>
<html lang="en">
<head>
{{template "head" .}}
</head>
<body>
{{template "header" .}}
<main>
  <section class="page-hero page-hero-split">
    <div class="wrap">
      <div class="page-hero-copy">
        <span class="eyebrow">The Portfolio</span>
        <h1>Browse the catalog</h1>
        <p class="lede">Every bottle currently in stock. Filter by producer, region, varietal, country, or vintage,
          or search the portfolio directly. What's listed reflects current wholesale availability.</p>
      </div>
      <figure class="page-hero-media">
        <img src="/assets/opt/finevines-portfolio-chosen-by-hand-hero.jpg" alt="Hands lifting a bottle from a wooden case in the cellar" width="896" height="1200">
      </figure>
    </div>
  </section>

  <section class="wrap">
    <div class="portfolio-layout">
      {{/* Backdrop for the off-canvas filter drawer (≤1024px). Starts hidden;
           assets/js/filters.js unhides it while the drawer is open and closes
           the drawer when it's clicked. Inert/invisible on desktop. */}}
      <div class="facets-backdrop" hidden aria-hidden="true"></div>

      <aside class="facets" id="portfolio-facets" aria-label="Filter the portfolio">
        {{/* Rail header. On desktop the trailing count mirrors the live result
             total (portfolio.js keeps it in sync) and the close button is
             hidden; as a mobile drawer the count hides and the ✕ shows. */}}
        <div class="facets-head">
          <span class="facets-title">Refine</span>
          <span class="facets-count">{{comma .Total}} wines</span>
          <button type="button" class="facets-close" aria-label="Close filters">&times;</button>
        </div>

        <div class="facet-search">
          <input type="search" id="portfolio-search" placeholder="Producer, wine, region&hellip;"
            aria-label="Search the portfolio">
        </div>

        {{/* Selected-value summary. Empty and hidden server-side; portfolio.js
             fills it with one removable chip per selected value and reveals it.
             It is the fastest way to see and undo what is currently applied
             without hunting back through five collapsed groups. */}}
        <div class="facet-chips" id="portfolio-chips" hidden>
          <div class="facet-chips-head">
            <span class="facet-chips-title">Selected</span>
            <button type="button" class="facet-clear">Clear all</button>
          </div>
          <div class="facet-chips-list"></div>
        </div>

        {{range .Facets}}
        {{/* One filter group. data-facet-group keys every control inside to its
             facet so portfolio.js can wire the whole rail by delegation — the
             value rows are re-rendered on every query, so nothing may hold a
             listener on an individual row.

             Big groups (producer/region/varietal) render only the top
             .Values by wine count and start COLLAPSED; the full set arrives
             with the catalog-index. Small groups render whole and start open. */}}
        <details class="facet-group facet" data-facet-group="{{.Facet}}" data-total="{{.Total}}"{{if .Big}} data-big="1"{{end}}{{if .Open}} open{{end}}>
          <summary>
            <span class="facet-name">{{.Label}}</span>
            {{/* The catalog-wide number of distinct values. portfolio.js
                 replaces it with how many are still AVAILABLE once other
                 facets narrow things. */}}
            <span class="facet-total">{{.Total}}</span>
            {{/* Count of selections inside this group, so a collapsed group
                 still announces that it is filtering. JS-only. */}}
            <span class="facet-selected" hidden></span>
          </summary>
          <div class="facet-body">
            {{if .Big}}
            {{/* Filter-within-group. Distinct from #portfolio-search above:
                 this narrows the VALUES in this one group and never touches
                 the result set. The placeholder names the full total so it is
                 clear the box reaches past the twelve rows shown. */}}
            <div class="facet-search">
              <input type="search" class="facet-filter" data-facet-filter="{{.Facet}}"
                placeholder="{{.Placeholder}}" aria-label="{{.Placeholder}}">
            </div>
            <div class="facet-meta">
              <span class="facet-match" aria-live="polite"></span>
              <button type="button" class="facet-sort" data-facet-sort="{{.Facet}}">Most wines</button>
            </div>
            {{end}}

            {{/* The value rows. portfolio.js replaces the CONTENTS of this
                 container on every query — the filter box and sort control
                 above sit outside it precisely so typing never destroys the
                 input holding focus. */}}
            <div class="facet-values{{if .Grid}} is-grid{{end}}" data-facet-values="{{.Facet}}">
              {{$facet := .Facet}}
              {{range .Values}}
              {{/* .facet-count carries the catalog-wide count server-side;
                   portfolio.js rewrites it with the live count of wines this
                   value would yield given the OTHER active facets. */}}
              <label class="facet-row"><input type="checkbox" data-facet="{{$facet}}" value="{{.Value}}"><span class="facet-box" aria-hidden="true"></span><span class="facet-label">{{.Value}}</span><span class="facet-count">{{.Count}}</span></label>
              {{end}}
            </div>

            {{if and .Big .HasMore}}
            {{/* Reveals the full ranked list. The label is rewritten by the JS
                 to the count available under current filters. */}}
            <button type="button" class="facet-expander" data-facet-expand="{{.Facet}}">{{.ExpandLabel}}</button>
            {{end}}
            <p class="facet-empty" hidden></p>
          </div>
        </details>
        {{end}}

        {{/* Sticky drawer footer — visible only when .facets is the ≤1024px
             off-canvas drawer. Committing with a live count is what makes
             filtering on a phone legible: you see what you are about to get
             before you dismiss the panel. */}}
        <div class="facets-drawer-foot">
          <button type="button" class="facets-apply">Show <span class="facets-apply-count">{{comma .Total}}</span> wines</button>
        </div>
      </aside>

      <div>
        <div class="portfolio-toolbar">
          <p id="portfolio-count">{{comma .Total}} wines</p>
          <div class="portfolio-toolbar-actions">
            {{/* Opens the .facets panel as an off-canvas drawer on ≤1024px;
                 display:none on desktop where the sidebar is always visible. */}}
            <button type="button" class="filters-toggle" aria-expanded="false" aria-controls="portfolio-facets">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 4h18v2.6l-7 7V21l-4-2v-5.4l-7-7V4Z"/></svg>
              Filters
            </button>
            {{/* Sort control. Values are the portfolio.js sort keys; the JS
                 re-sorts the whole result set (not just this page) and empty/NV
                 vintages always sort last. With JS off the server order (by
                 slug) stands and this control is inert. */}}
            <label class="portfolio-sort">
              <span class="portfolio-sort-label">Sort</span>
              <select id="portfolio-sort" aria-label="Sort the portfolio">
                <option value="producer">Producer</option>
                <option value="name">Name</option>
                <option value="vintage">Vintage</option>
                <option value="region">Region</option>
              </select>
            </label>
            <div class="view-toggle" role="group" aria-label="Choose portfolio layout">
              <button type="button" class="view-toggle-btn is-active" data-view="cards" aria-pressed="true">Cards</button>
              <button type="button" class="view-toggle-btn" data-view="list" aria-pressed="false">List</button>
            </div>
          </div>
        </div>

        <ul class="wine-grid view-cards" style="list-style:none;margin:0;padding:0;"
            data-index-url="{{.IndexURL}}" data-page-size="{{.PageSize}}"
            data-page="{{.PageNum}}" data-page-count="{{.PageCount}}">
          {{/* One real <li><a> card per wine on THIS page, from the shared
               "winecard" definition in card.html.tmpl — the same one the hub
               pages use and the one portfolio.js's createCard() mirrors, so
               server- and JS-rendered cards are byte-for-byte equivalent to
               the eye. */}}
          {{range .Wines}}
          {{template "winecard" .}}
          {{end}}
        </ul>

        {{/* Empty state — shown only by portfolio.js when a filter combination
             matches nothing; hidden (and empty) for the server-rendered pages,
             which always have wines. */}}
        <p id="portfolio-empty" class="portfolio-empty" hidden>No wines match these filters.
          <button type="button" class="portfolio-clear">Clear all filters</button></p>

        {{/* Crawlable pagination. These real <a> links let a no-JS visitor or a
             search crawler walk every page of the catalog; portfolio.js
             rebuilds this nav's contents to page client-side (rel=prev/next are
             preserved for both crawlers and the JS). A missing neighbour
             renders as a disabled <span> so the control never dead-links. */}}
        <nav class="pagination" aria-label="Portfolio pages">
          {{if .PrevURL}}<a class="pagination-btn pagination-prev" rel="prev" href="{{.PrevURL}}">Previous</a>{{else}}<span class="pagination-btn pagination-prev is-disabled" aria-disabled="true">Previous</span>{{end}}
          <span class="pagination-status">Page {{.PageNum}} of {{.PageCount}}</span>
          {{if .NextURL}}<a class="pagination-btn pagination-next" rel="next" href="{{.NextURL}}">Next</a>{{else}}<span class="pagination-btn pagination-next is-disabled" aria-disabled="true">Next</span>{{end}}
        </nav>
      </div>
    </div>
  </section>
</main>
{{template "footer" .}}
<script src="{{.PortfolioJSURL}}" defer></script>
<script src="{{.FiltersJSURL}}" defer></script>
</body>
</html>
{{end}}
