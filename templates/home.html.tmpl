{{define "home"}}<!doctype html>
<html lang="en">
<head>
{{template "head" .}}
{{/* Organization schema: the machine-readable service-area statement. The
     visible copy claims Illinois; areaServed carries BOTH the state and the
     "Chicagoland" region so geo queries for either resolve to FineVines
     without the copy having to keyword-stuff. Values interpolate via
     html/template's contextual JSON escaping (same pattern as wine.html.tmpl
     and newspost.html.tmpl). */}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "FineVines",
  "url": {{printf "%s/" .BaseURL}},
  "logo": {{printf "%s/assets/img/finevines-logo.png" .BaseURL}},
  "description": "Licensed wholesale distributor of wine and spirits, State of Illinois.",
  "telephone": {{.Content.Contact.PhoneHref}},
  "email": {{.Content.Contact.Email}},
  "areaServed": [
    {"@type": "State", "name": "Illinois"},
    {"@type": "Place", "name": "Chicagoland"}
  ]
}
</script>
</head>
<body>
{{template "header" .}}
<main>
  <section class="home-hero">
    <div class="wrap">
      <div class="home-hero-copy">
        <span class="eyebrow">Wholesale Wine &amp; Spirits &middot; Illinois</span>
        <h1>Pouring elegance with a sommelier's touch.</h1>
        <p class="lede">FineVines is a licensed wholesale distributor bringing a hand-selected portfolio of wine
          and spirits to Illinois restaurants, retailers, and hospitality tables. Sourced with care, stored
          with precision, and poured with a sommelier's instinct for the right bottle at the right moment.</p>
        <p class="hero-actions">
          <a class="btn btn-primary" href="/portfolio/">Browse the Portfolio</a>
          <a class="btn btn-ghost" href="/contact/">Get in Touch</a>
        </p>
      </div>
      <figure class="home-hero-media">
        <img src="/assets/opt/finevines-sommeliers-working-table-hero.jpg" alt="Sommeliers at work over a tasting table" width="848" height="1264"
          loading="eager" fetchpriority="high">
      </figure>
    </div>
  </section>

  {{/* Credibility band: counts the live catalog can back, presented as a
       quiet ledger. Values regenerate from wines.json on every build
       (build.go ledgerStats) so the band can never overstate the portfolio;
       thin catalogs omit it entirely. Counts, never superlatives. */}}
  {{if .Ledger}}<section class="home-ledger" aria-label="FineVines at a glance">
    <div class="wrap">
      {{range .Ledger}}<div class="stat">
        <span class="num">{{.Value}}</span>
        <span class="lbl">{{.Label}}</span>
      </div>
      {{end}}
    </div>
  </section>{{end}}

  {{if .FeaturedWines}}<section class="wrap home-featured">
    <div class="home-section-heading">
      <div>
        <span class="eyebrow">The Heart of What We Do</span>
        <h2>Bottles Chosen with Purpose</h2>
      </div>
      <a class="text-link" href="/portfolio/">Explore the full portfolio &rarr;</a>
    </div>
    <ul class="wine-grid view-cards home-wine-grid">
      {{range .FeaturedWines}}<li>
        <a class="wine-card" href="/wines/{{.Slug}}/">
          <div class="thumb">
            <img src="/{{.ImagePath}}" alt="Bottle of {{spaceJoin .Producer .Name .Vintage}}" loading="lazy">
          </div>
          <div class="body">
            {{if .Producer}}<span class="producer">{{.Producer}}</span>{{end}}
            <h3>{{.Name}}{{if .Vintage}} <span class="vintage">{{.Vintage}}</span>{{end}}</h3>
            {{if or .Region .Varietal}}<span class="meta">{{.Region}}{{if and .Region .Varietal}} &middot; {{end}}{{.Varietal}}</span>{{end}}
          </div>
        </a>
      </li>{{end}}
    </ul>
  </section>{{end}}

  {{/* Sales-driven: the top movers from data/hot-sellers.json (written by the
       nightly enrich run from the org's invoice ledger), resolved and capped
       in build.go. Curation only — the cards NEVER show sales volumes; case
       velocity is competitively sensitive for a distributor. Omitted entirely
       when the ranking is missing or too thin to read as a real pulse. */}}
  {{if .HotSellers}}<section class="wrap home-hot-sellers">
    <div class="home-section-heading">
      <div>
        <span class="eyebrow">In Demand</span>
        <h2>What Illinois Is Pouring</h2>
      </div>
      <a class="text-link" href="/portfolio/">Browse the full portfolio &rarr;</a>
    </div>
    <p class="lede">The bottles moving fastest through lists and shelves across Illinois this month
      &mdash; in stock now and ready to order.</p>
    <ul class="wine-grid view-cards home-wine-grid">
      {{range .HotSellers}}<li>
        <a class="wine-card" href="/wines/{{.Slug}}/">
          <div class="thumb">
            <img src="/{{.ImagePath}}" alt="Bottle of {{spaceJoin .Producer .Name .Vintage}}" loading="lazy">
          </div>
          <div class="body">
            {{if .Producer}}<span class="producer">{{.Producer}}</span>{{end}}
            <h3>{{.Name}}{{if .Vintage}} <span class="vintage">{{.Vintage}}</span>{{end}}</h3>
            {{if or .Region .Varietal}}<span class="meta">{{.Region}}{{if and .Region .Varietal}} &middot; {{end}}{{.Varietal}}</span>{{end}}
            {{with avail .}}<span class="avail">{{.}}</span>{{end}}
          </div>
        </a>
      </li>{{end}}
    </ul>
  </section>{{end}}

  {{/* The Book: the house judged by its portfolio — a roll of the catalog's
       deepest holdings (or site.json's bookProducers, the client's own
       shortlist), each name deep-linking to its permanent producer page.
       Replaced the Featured Producers cards AND the Featured Regions links
       (2026-07-29): one band, one question ("who are your relationships?"),
       answered once. */}}
  {{if .Book.Producers}}<section class="home-book">
    <div class="wrap">
      <span class="eyebrow">The Book</span>
      <h2>The portfolio is the r&eacute;sum&eacute;.</h2>
      <p class="lede">In this business, a house is judged by its book. Ours runs from old-world benchmarks
        to the producers reshaping the new world: {{.Book.CountLabel}}, each carried because the
        wine earned it.</p>
      <p class="book-roll">{{range $i, $p := .Book.Producers}}{{if $i}}<span class="sep">&middot;</span>{{end}}<a href="{{$p.URL}}">{{$p.Name}}</a>{{end}}</p>
      <a class="text-link book-link" href="/portfolio/">Browse the full portfolio &rarr;</a>
    </div>
  </section>{{end}}

  {{/* Permanent, crawlable catalog routes. These are deliberately prominent
       on the homepage as well as present in the global footer: a sitemap can
       advertise a URL, but these links tell people and search engines how the
       catalog is organized. Individual collection pages provide the deeper
       producer <-> region <-> varietal cross-link graph. */}}
  <section class="wrap home-browse" aria-labelledby="home-browse-title">
    <div class="home-section-heading">
      <div>
        <span class="eyebrow">Explore the Portfolio</span>
        <h2 id="home-browse-title">Find a bottle from any angle.</h2>
      </div>
      <a class="text-link" href="/portfolio/">Search and filter &rarr;</a>
    </div>
    <div class="home-browse-grid">
      <article class="home-browse-card">
        <span class="home-browse-label">The Estates</span>
        <h3><a href="/producers/">Producers</a></h3>
        <p>Meet the growers, domaines, and houses represented in the FineVines book.</p>
        {{with .BrowseProducers}}<ul class="home-browse-links" aria-label="Prominent producers">
          {{range .}}<li><a href="{{.URL}}">{{.Name}}</a></li>{{end}}
        </ul>{{end}}
        <a class="text-link" href="/producers/">Browse all producers &rarr;</a>
      </article>
      <article class="home-browse-card">
        <span class="home-browse-label">The Places</span>
        <h3><a href="/regions/">Regions</a></h3>
        <p>Travel the portfolio by the vineyards and winegrowing regions behind each bottle.</p>
        {{with .BrowseRegions}}<ul class="home-browse-links" aria-label="Prominent regions">
          {{range .}}<li><a href="{{.URL}}">{{.Name}}</a></li>{{end}}
        </ul>{{end}}
        <a class="text-link" href="/regions/">Browse all regions &rarr;</a>
      </article>
      <article class="home-browse-card">
        <span class="home-browse-label">The Grapes</span>
        <h3><a href="/varietals/">Varietals</a></h3>
        <p>Explore current selections through the grape varieties that give them their voice.</p>
        {{with .BrowseVarietals}}<ul class="home-browse-links" aria-label="Prominent varietals">
          {{range .}}<li><a href="{{.URL}}">{{.Name}}</a></li>{{end}}
        </ul>{{end}}
        <a class="text-link" href="/varietals/">Browse all varietals &rarr;</a>
      </article>
    </div>
  </section>

  <section class="wrap">
    <span class="eyebrow">News &amp; Events</span>
    <h2>From the Tasting Room</h2>
    {{if .LatestNews}}
    <div class="news-list">
      {{range .LatestNews}}<article class="news-item">
        <div class="date">{{.Date}}</div>
        <div>
          <h3><a href="/news/{{.Slug}}/">{{.Title}}</a></h3>
          <p class="excerpt">{{excerpt .Body 200}}</p>
          <span class="category">{{.Category}}</span>
        </div>
      </article>
      {{end}}
    </div>
    {{else}}{{template "news-empty" .}}{{end}}
  </section>
</main>
{{template "footer" .}}
</body>
</html>
{{end}}
