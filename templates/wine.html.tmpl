{{/*
  wine.html.tmpl — one page per wine, dist/wines/<slug>/index.html.

  Dot is a winePage (build.go): the embedded `page` supplies Title/
  Description/Path/BaseURL for head/header/footer (same contract every page
  uses), and .Wine carries this wine's own fields. Product/Offer JSON-LD is
  emitted from .Wine — no price (wholesale). Availability is InStock for
  every wine reachable through the normal catalog (ineligible wines,
  stockQty <= 0 or SKU starting "9", never reach wines.json in the first
  place) except a delisted wine retained as StatusUnavailable: .Unavailable
  flips its offer to OutOfStock and swaps the body's availability markup for
  a plain notice (see build.go's winePage.Unavailable). html/template's
  contextual escaping handles the JSON-encoding of interpolated values inside
  the application/ld+json <script> block; nothing here hand-rolls that
  escaping.
*/}}
{{define "wine"}}<!doctype html>
<html lang="en">
<head>
{{template "head" .}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{printf "%s %s %s" .Wine.Producer .Wine.Name .Wine.Vintage}},
  "image": {{printf "%s/%s" .BaseURL .Wine.ImagePath}},
  "description": {{.Wine.Description}},
  "sku": {{.Wine.SKU}},
  "brand": {"@type": "Brand", "name": {{.Wine.Producer}}},{{if .LDProps}}
  "additionalProperty": [{{range $i, $p := .LDProps}}{{if $i}}, {{end}}{"@type": "PropertyValue", "name": {{$p.Name}}, "value": {{$p.Value}}}{{end}}],{{end}}
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/{{if .Unavailable}}OutOfStock{{else}}InStock{{end}}",
    "seller": {"@type": "Organization", "name": "FineVines Ltd."}
  }
}
</script>
</head>
<body>
{{template "header" .}}
<main>
  <section class="wrap">
    <div class="wine-detail">
      <div class="photo">
        <img src="/{{.Wine.ImagePath}}" alt="Bottle of {{.Wine.Producer}} {{.Wine.Name}} {{.Wine.Vintage}}">
      </div>
      <div>
        <span class="producer">{{.Wine.Producer}}</span>
        <h1>{{.Wine.Name}} {{.Wine.Vintage}}</h1>
        {{if .Unavailable}}
        <p class="wine-unavailable">This wine is currently unavailable. Contact your FineVines representative about upcoming vintages and allocations.</p>
        {{end}}
        <div class="facts">
          {{if .Wine.Region}}<span>Region<b>{{.Wine.Region}}</b></span>{{end}}
          {{if .Wine.Appellation}}<span>Appellation<b>{{.Wine.Appellation}}</b></span>{{end}}
          {{if .Wine.Country}}<span>Country<b>{{.Wine.Country}}</b></span>{{end}}
          {{if .Wine.Varietal}}<span>Varietal<b>{{.Wine.Varietal}}</b></span>{{end}}
          {{if .Wine.Color}}<span>Colour<b>{{.Wine.Color}}</b></span>{{end}}
          {{if .Wine.Style}}<span>Style<b>{{.Wine.Style}}</b></span>{{end}}
          {{if .Wine.ABV}}<span>Alcohol<b>{{.Wine.ABV}}</b></span>{{end}}
          {{if .Wine.BottleSize}}<span>Bottle<b>{{.Wine.BottleSize}}</b></span>{{end}}
          {{if .Wine.DrinkWindow}}<span>Drink window<b>{{.Wine.DrinkWindow}}</b></span>{{end}}
        </div>
        <p>{{.Wine.Description}}</p>
        {{if .Wine.SommelierNotes}}<aside class="callout sommelier-notes">
          <p>{{.Wine.SommelierNotes}}</p>
        </aside>{{end}}
        {{if or .Wine.Aroma .Wine.Palate .Wine.Finish}}
        <div class="tasting">
          <h2>Tasting</h2>
          <dl>
            {{if .Wine.Aroma}}<dt>Aroma</dt><dd>{{.Wine.Aroma}}</dd>{{end}}
            {{if .Wine.Palate}}<dt>Palate</dt><dd>{{.Wine.Palate}}</dd>{{end}}
            {{if .Wine.Finish}}<dt>Finish</dt><dd>{{.Wine.Finish}}</dd>{{end}}
          </dl>
        </div>
        {{end}}
        {{if .Wine.FoodPairings}}
        <div class="pairings">
          <h2>Pairs with</h2>
          <ul>{{range .Wine.FoodPairings}}<li>{{.}}</li>{{end}}</ul>
        </div>
        {{end}}
        {{/* Other vintages of this same wine, newest first. The portfolio
             collapses vintages into one card that links only the current
             release, so these links are the ONLY internal path to an older
             vintage's page — without them 649 pages are reachable from
             sitemap.xml alone, which search engines read as pages the site
             itself does not think are worth linking. Rendered only when the
             wine actually has other years (see winePage.OtherVintages). */}}
        {{if .OtherVintages}}
        <nav class="wine-vintages" aria-label="Other vintages of this wine">
          <h2>Other vintages</h2>
          <ul>{{range .OtherVintages}}<li><a href="/wines/{{.Slug}}/">{{.Label}}</a></li>{{end}}</ul>
        </nav>
        {{end}}
      </div>
    </div>
  </section>
</main>
{{template "footer" .}}
</body>
</html>
{{end}}
