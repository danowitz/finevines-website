import * as BunnySDK from "@bunny.net/edgescript-sdk";

// REDIRECT_MAP_URL points at the deployed redirects.json (the same file
// internal/redirects.Save writes and internal/deploy uploads as an
// ordinary site asset) — NOT baked into this script, so a redirects.json
// refresh never requires touching or redeploying this file.
const REDIRECT_MAP_URL = "{{.RedirectsURL}}";

// redirectsPromise memoizes the in-flight/completed fetch+parse of
// REDIRECT_MAP_URL for the lifetime of this isolate. Concurrent requests
// that arrive before the first fetch resolves all await the SAME promise
// (no thundering herd of duplicate fetches per isolate).
let redirectsPromise: Promise<Map<string, string>> | null = null;

async function loadRedirects(): Promise<Map<string, string>> {
  if (redirectsPromise) {
    return redirectsPromise;
  }

  redirectsPromise = (async () => {
    try {
      const res = await fetch(REDIRECT_MAP_URL);
      if (!res.ok) {
        throw new Error(`fetch ${REDIRECT_MAP_URL}: status ${res.status}`);
      }
      const data = (await res.json()) as Record<string, string>;
      return new Map(Object.entries(data));
    } catch (err) {
      // Fail open, never break the site: log and hand back an empty map,
      // which makes every lookup below miss and pass through to origin.
      console.error("finevines redirects: failed to load", REDIRECT_MAP_URL, err);
      // Don't cache the failure — the next request gets to retry the
      // fetch instead of being stuck with an empty map for the isolate's
      // whole lifetime.
      redirectsPromise = null;
      return new Map<string, string>();
    }
  })();

  return redirectsPromise;
}

