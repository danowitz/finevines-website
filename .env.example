# Salesforce (source of truth for enrich — connected app / OAuth credentials)
FINEVINES_SF_BASE_URL=
FINEVINES_SF_CLIENT_ID=
FINEVINES_SF_CLIENT_SECRET=
FINEVINES_SF_API_VERSION=
# Set to 1/true to read the embedded sample roster instead of a live org
# (develop/exercise enrich before the Connected App exists — see issue #1).
# When on, the three FINEVINES_SF_* credential vars above are not required.
FINEVINES_SF_MOCK=

# OpenAI (web-search enrichment + image generation — all-OpenAI, decided 2026-07-27)
OPENAI_API_KEY=
# Enrichment model (must support the web_search tool); default gpt-4.1
FINEVINES_OPENAI_MODEL=

# Image generation (currently Gemini/Imagen; migrating to OpenAI gpt-image-1)
FINEVINES_GEMINI_API_KEY=
FINEVINES_IMAGE_MODEL=

# Bunny.net (storage zone for generated assets, CDN pull zone, deploy)
FINEVINES_BUNNY_STORAGE_ZONE=
FINEVINES_BUNNY_STORAGE_KEY=
FINEVINES_BUNNY_STORAGE_ENDPOINT=
FINEVINES_BUNNY_API_KEY=
FINEVINES_BUNNY_PULL_ZONE_ID=
FINEVINES_BUNNY_SCRIPT_ID=

# Site
FINEVINES_SITE_BASE_URL=
# Legacy site the `redirects` crawl discovers URLs from. Leave empty in
# production (defaults to FINEVINES_SITE_BASE_URL — same domain after
# cutover); set to https://finevines.com while the new site is staged on a
# test domain so the crawl hits the OLD site, not the staged new one.
FINEVINES_OLD_SITE_URL=
# Where the deployed Edge middleware fetches redirects.json at runtime.
# MUST be the pull zone's *.b-cdn.net default hostname (e.g.
# https://finevines-com.b-cdn.net/redirects.json) — an edge script cannot
# fetch a custom hostname served by its own pull zone (TLS loopback
# failure, verified live 2026-07-29). Defaults to
# FINEVINES_SITE_BASE_URL/redirects.json, which will NOT work on Bunny.
FINEVINES_REDIRECTS_MAP_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). The old site's UA-41731070-1 is a dead Universal Analytics tag — get a GA4 ID.
FINEVINES_GA_ID=

# Digest email. Sent by `finevines notify` through the client's SMTP relay
# (smtp.com) after a pipeline run that changed something; never sent for a
# no-change run. All four relay settings are required for a real send.
FINEVINES_SMTP_HOST=
# 587 for STARTTLS (the usual submission port) or 465 for implicit TLS. TLS is
# required either way — the send fails rather than submitting in the clear.
FINEVINES_SMTP_PORT=
FINEVINES_SMTP_USER=
FINEVINES_SMTP_PASS=
# Comma-separated recipients, e.g. george@finevines.com,barbara@finevines.com
FINEVINES_NOTIFY_TO=
# The address to send from. There is no default: it has to be an address the
# relay is authorised to send for (SPF/DKIM aligned), and a mailbox someone
# reads — the digest invites a reply when a bottle photograph is wrong.
FINEVINES_NOTIFY_FROM=
